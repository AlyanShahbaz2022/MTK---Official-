# ----------------------------------------------------------------------------
# MTK environment variables — copy to .env.local and fill in real values.
# NEVER commit .env.local (see .gitignore). Spec project.md §6.10.
#
# PRODUCTION (Vercel): .env.local is NOT deployed. Add EVERY variable below in
# the Vercel dashboard → Settings → Environment Variables (Production), then
# REDEPLOY. Use your real domain for the URL/host vars (NOT localhost).
# ----------------------------------------------------------------------------

# Database (Supabase / Neon PostgreSQL)
# DATABASE_URL = pooled connection (pgbouncer) used by the app.
# DIRECT_URL   = direct/session connection used for migrations.
# If your password contains reserved characters (@ : / ? # , etc.) URL-encode them.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth.js (NextAuth v5)
# Generate a secret with: npx auth secret  (or: openssl rand -base64 32)
# AUTH_URL must be the FULL site origin. Locally: http://localhost:3000
# On Vercel: https://your-app.vercel.app  (used to build login/callback redirects)
# AUTH_TRUST_HOST=true lets Auth.js trust the deploy host behind Vercel's proxy.
AUTH_SECRET="replace-with-generated-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth (optional provider)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (optional — card payments. Test mode keys to start.)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Cloudinary (image storage — product images + EasyPaisa payment proofs)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="MTK - Official Images"

# Email (Gmail SMTP via Nodemailer — signup OTP + payment-verified emails)
# SMTP_PASS is a Google "App Password" (16 chars), NOT your account password.
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="MTK <you@gmail.com>"

# EasyPaisa manual-transfer account shown on checkout
NEXT_PUBLIC_EASYPAISA_NAME="MTK Store"
NEXT_PUBLIC_EASYPAISA_NUMBER="0316-0749849"

# App — FULL site origin. Locally http://localhost:3000; on Vercel your domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
