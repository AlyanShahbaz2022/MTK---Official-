# ----------------------------------------------------------------------------
# MTK environment variables — copy to .env.local and fill in real values.
# NEVER commit .env.local (see .gitignore). Spec project.md §6.10.
# ----------------------------------------------------------------------------

# Database (Neon / Supabase PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js (NextAuth v5)
# Generate a secret with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-generated-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional provider)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (test mode keys to start)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
