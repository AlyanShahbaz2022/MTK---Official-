// MTK Prisma schema.
// Phase 1 establishes the auth-critical models + RBAC + audit log.
// Product/Order/Cart models will be expanded in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer) connection for the app at runtime.
  url       = env("DATABASE_URL")
  // Direct connection for migrations / introspection (Supabase session pooler).
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth & RBAC
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Null for OAuth-only users (Google). Set for credentials users.
  passwordHash  String?
  role          Role      @default(USER)

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  auditLogs AuditLog[]
  cart      Cart?
  wishlist  Wishlist?
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// OAuth provider accounts (Auth.js adapter).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Signup email verification: 6-digit OTP delivered by email.
// One active row per email (upserted on resend). The code is stored hashed.
model EmailOtp {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String  @default("PK")
  isDefault  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Security: audit logging (spec project.md §6.13)
// ---------------------------------------------------------------------------

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  REGISTER
  LOGOUT
  PASSWORD_CHANGE
  ADMIN_ACTION
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  userId    String?
  email     String? // captured even when login fails / user unknown
  ip        String?
  userAgent String?
  meta      Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Catalog (Phase 3)
// ---------------------------------------------------------------------------

// Top-level gender/department a product belongs to.
enum Gender {
  MEN
  WOMEN
  KIDS
  UNISEX
}

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  gender   Gender
  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gender])
  @@index([slug])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String  @db.Text
  // Price stored in minor units (paisa) to avoid float rounding errors.
  basePrice   Int
  gender      Gender
  categoryId  String
  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)
  // Denormalized rating cache (updated when reviews change in Phase 6).
  ratingAvg   Float   @default(0)
  ratingCount Int     @default(0)

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([gender])
  @@index([slug])
  @@index([isActive])
  @@index([isFeatured])
}

// A purchasable size/color combination with its own stock + SKU.
model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  size          String
  color         String
  sku           String  @unique
  stock         Int     @default(0)
  // Optional override; falls back to Product.basePrice when null. Minor units.
  priceOverride Int?

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size, color])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  position  Int     @default(0)
  // Cloudinary public id (Phase 7 uploads); null for seeded/remote images.
  publicId  String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Cart & Wishlist (Phase 4)
// ---------------------------------------------------------------------------

model Cart {
  id     String @id @default(cuid())
  userId String @unique

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int    @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per variant per cart; quantity is incremented instead of duplicated.
  @@unique([cartId, variantId])
  @@index([cartId])
}

model Wishlist {
  id     String @id @default(cuid())
  userId String @unique

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id         String @id @default(cuid())
  wishlistId String
  variantId  String

  wishlist Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([wishlistId, variantId])
  @@index([wishlistId])
}

// ---------------------------------------------------------------------------
// Orders & Checkout (Phase 5)
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  COD
  CARD
  EASYPAISA
}

enum CouponType {
  PERCENT
  FIXED
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod

  // All monetary amounts in minor units (paisa).
  subtotal   Int
  shipping   Int    @default(0)
  discount   Int    @default(0)
  total      Int
  couponCode String?

  // Shipping address snapshot (captured at order time).
  email      String
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String  @default("PK")

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  // EasyPaisa manual transfer: customer-uploaded proof + admin review trail.
  paymentProofUrl    String?
  paymentProofId     String? // Cloudinary public id (for deletion)
  paymentVerifiedAt  DateTime?
  paymentReviewedBy  String? // admin user id who accepted/rejected
  paymentRejectReason String?

  items OrderItem[]
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String? // nullable so the line survives variant deletion

  // Product snapshot (so historical orders are stable).
  productName  String
  productSlug  String?
  variantLabel String
  sku          String?
  unitPrice    Int
  quantity     Int
  lineTotal    Int
  image        String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  value          Int // PERCENT: 0-100; FIXED: minor units
  minSubtotal    Int        @default(0)
  maxRedemptions Int?
  timesRedeemed  Int        @default(0)
  expiresAt      DateTime?
  isActive       Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}
